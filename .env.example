# -------------------------
# Nexus backend - .env.example
# -------------------------
# Copy this file to .env and fill in real values.
# Do NOT commit .env to version control.

# Server
PORT=5000
NODE_ENV=development

# PostgreSQL (read by config/database.js)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=nexus
DB_USER=nexus_user
DB_PASSWORD=your_postgresql_password

# JWT
# Use a long random string, e.g. node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_this_with_a_long_random_secret
# Token lifetime such as 1h or 1d. Defaults to 1d when unset.
JWT_EXPIRE=1d

# Demo login: npm run seed stores a bcrypt hash of this as demo@nexus.com's password,
# and npm test logs in with it.
DEMO_PASSWORD=choose_a_demo_password
