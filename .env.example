# -------------------------
# Nexus PoC - .env.example
# -------------------------
# Copy this file to .env and fill in real values.
# Do NOT commit .env to version control.

# ---------- Backend (Express + PostgreSQL) ----------

# Server
PORT=5000
NODE_ENV=development

# PostgreSQL
# Example: postgres://user:password@localhost:5432/nexus
DATABASE_URL=postgres://user:password@localhost:5432/nexus

# JWT
# Use a long random string in production
JWT_SECRET=your-super-secret-jwt-key-change-in-prod

# Demo user (optional, if you want these in env instead of code)
DEMO_EMAIL=demo@nexus.com
DEMO_PASSWORD=demo-password

# ---------- Frontend (React + Vite) ----------

# Backend API base URL used by the frontend
VITE_API_BASE_URL=http://localhost:5000/api

# Optional: feature flags / toggles
VITE_ENABLE_MOCK_DATA=false